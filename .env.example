# Database (required for app + migrations)
DB_NAME=ircihumane
DB_USERNAME=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# SMTP (required for outbound email)
# On cPanel, try: SMTP_HOST=mail.ircng.org or localhost, port 587 (SMTP_SECURE=false) or 465 (SMTP_SECURE=true)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Email defaults
MAIL_FROM=noreply@ircng.org

# Password reset link base (frontend route: /reset-password?token=...)
FRONTEND_URL=https://ircng.org
PASSWORD_RESET_EXPIRY=1h

# Comma-separated origins allowed for browser API calls
CORS_ORIGINS=https://ircng.org,https://www.ircng.org
