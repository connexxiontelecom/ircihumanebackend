# SMTP (required for outbound email)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Email defaults
MAIL_FROM=noreply@ircng.org

# Password reset link base (frontend route: /reset-password?token=...)
FRONTEND_URL=https://ircng.org
PASSWORD_RESET_EXPIRY=1h

# Comma-separated origins allowed for browser API calls
CORS_ORIGINS=https://ircng.org,https://www.ircng.org
